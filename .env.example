# =============================================================================
# FLOW — Environment Variable Configuration
# Copy this file to server/.env and fill in your real values
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# -----------------------------------------------------------------------------
# GROQ AI ENGINE CONFIGURATION (Ultra-Fast Llama 3.3 70B & 8B Instant)
# Get your free key from: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKey

# -----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Nodemailer / Gmail App Password)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-16-character-app-password
EMAIL_FROM="FLOW AI (Powered by IMV)" <your-email@gmail.com>
